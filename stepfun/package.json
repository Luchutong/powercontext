{
  "name": "stepfun-edge-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:restart": "node scripts/restart-test.mjs",
    "bench": "node scripts/benchmark.mjs",
    "models": "node scripts/download-model.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "express": "5.1.0",
    "seekdb": "1.4.0",
    "undici": "7.16.0"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "vite": "7.1.12"
  }
}
