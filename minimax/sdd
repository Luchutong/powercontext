#!/usr/bin/env bash
# SDD context module entry point. Runs `python -m sdd_context` with the project virtualenv.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${SDD_PYTHON:-$HERE/.venv/bin/python}"
if [[ ! -x "$PY" ]]; then
  echo "未找到 $PY，请先运行 scripts/install.sh" >&2
  exit 2
fi
cd "$HERE"
exec "$PY" -m sdd_context "$@"
