# Copy to minimax/.env (git-ignored) and fill in values. Never commit real credentials.
# Empty values are ignored.

# MiniMax official API, OpenAI-compatible Chat Completions.
# Only needed for `./sdd edit --mode live` (or SDD_EDIT_MODE=live bash scripts/demo_accept.sh).
MINIMAX_API_KEY=
# China mainland: https://api.minimaxi.com/v1   International: https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# MINIMAX_MAX_TOKENS=32768
# MINIMAX_TIMEOUT=600
# Set to 0 if the selected model rejects reasoning_split.
# MINIMAX_REASONING_SPLIT=1

# Optional: MiniMax official Hugging Face Space used by `./sdd edit --mode hf-space`.
# MINIMAX_HF_SPACE=MiniMaxAI/MiniMax-Text-01

# Local PowerContext Server port and runtime directory (defaults shown).
# SDD_PC_PORT=17439
# SDD_RUNTIME_DIR=./.runtime

# Optional: use a seekdb / OceanBase server instead of embedded seekdb.
# SDD_SEEKDB_HOST=127.0.0.1
# SDD_SEEKDB_PORT=2881
# SDD_SEEKDB_USER=root
# SDD_SEEKDB_PASSWORD=
# SDD_SEEKDB_DATABASE=sdd_context
